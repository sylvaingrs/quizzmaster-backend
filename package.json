{
  "name": "quizzmaster",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "lint": "eslint --cache . && tsc",
    "tsc": "tsc",
    "gateway": "yarn workspace @quizzmaster-backend/api-gateway run start",
    "user": "yarn workspace @quizzmaster-backend/user-service run start",
    "room": "yarn workspace @quizzmaster-backend/room-service run start",
    "quizz": "yarn workspace @quizzmaster-backend/quizz-service run start",
    "score": "yarn workspace @quizzmaster-backend/score-service run start"
  }
}
