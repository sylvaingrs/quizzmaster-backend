{
  "name": "quizzmaster",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "dev:up": "NODE_ENV='development' docker compose -f docker-compose.dev.yml up",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "up": "NODE_ENV='production' docker compose up -d",
    "down": "docker compose down",
    "lint": "eslint --cache . && tsc",
    "tsc": "tsc",
    "gateway": "yarn workspace @quizzmaster-backend/api-gateway run start",
    "room": "yarn workspace @quizzmaster-backend/room-service run start",
    "quizz": "yarn workspace @quizzmaster-backend/quizz-service run start",
    "score": "yarn workspace @quizzmaster-backend/score-service run start",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageExtensions": {},
  "pnpIgnorePatterns": [
    "**/src/generated/**"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^25.5.0"
  }
}
