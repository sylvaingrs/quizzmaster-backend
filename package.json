{
  "name": "quizzmaster",
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "dev:up": "NODE_ENV='development' docker compose -f docker-compose.dev.yml up",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "lint": "eslint --cache . && tsc",
    "tsc": "tsc",
    "gateway": "NODE_ENV='development' yarn workspace @quizzmaster-backend/api-gateway run start",
    "user": "NODE_ENV='development' yarn workspace @quizzmaster-backend/user-service run start",
    "room": "NODE_ENV='development' yarn workspace @quizzmaster-backend/room-service run start",
    "quizz": "NODE_ENV='development' yarn workspace @quizzmaster-backend/quizz-service run start",
    "score": "NODE_ENV='development' yarn workspace @quizzmaster-backend/score-service run start"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "dotenv": "^17.3.1"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageExtensions": {},
  "pnpIgnorePatterns": [
    "**/src/generated/**"
  ]
}
